# Copy to .env and fill in. Never commit .env.

# Deployer key for all three testnets. Use a testnet-only wallet.
PRIVATE_KEY=

# RPC URLs. Public endpoints work for deploys; use provider URLs (Alchemy, QuickNode, ...)
# for the latency harness, because public RPCs rate-limit fast polling.
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# Chain IDs
BASE_SEPOLIA_CHAIN_ID=84532
UNICHAIN_SEPOLIA_CHAIN_ID=1301
LASNA_CHAIN_ID=5318007

# Reactive system contract and callback proxies (verified Nov 19, 2026)
SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
BASE_SEPOLIA_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
UNICHAIN_SEPOLIA_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1

# Morpho Blue on Base Sepolia (verified on-chain)
MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
